{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "epubzilla",
  "version": "0.5.0",
  "identifier": "io.github.seancassiere.epubzilla",
  "build": {
    "beforeDevCommand": "pnpm --filter @epubzilla/frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @epubzilla/frontend build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "epubzilla",
        "width": 1100,
        "height": 780
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SeanCassiere/epubzilla/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDQjA4OTVBMzQzMTMxQzAKUldUQU1URTBXb213TEJkMlBmZENoUkx1RmJHak9KZnRPcnhibzVvZmlYMHdyM1h3aUYvZkVoaW8K"
    }
  }
}
