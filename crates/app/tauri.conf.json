{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "epubzilla",
  "version": "0.2.1",
  "identifier": "io.github.seancassiere.epubzilla",
  "build": {
    "beforeDevCommand": "pnpm --filter @epubzilla/frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @epubzilla/frontend build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "epubzilla",
        "width": 1100,
        "height": 780
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
